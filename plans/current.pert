project KAFS_CURRENT:
  version 1
  title "KAFS accepted-goal residual plan"
  description |
    Canonical residual network for next-task selection. The v7 dense
    regular-file block tree and non-destructive software qualification are
    complete through T55. The active Ubuntu system disk is a Windows-host VHDX,
    so the dedicated-image Windows-host harness is now ready. Its actual
    terminate/restart recovery run remains the runnable predecessor of approved
    real-media qualification. Physical wear and isolated power-cut claims remain
    blocked. Off-goal work is owned in its linked backlog or PERT narrative and
    is not added here as a false predecessor.
  as_of 2026-07-21
  duration_unit day
  finish PRODUCTION_CUTOVER_DECIDED

resource PRIMARY_STREAM:
  title "Primary implementation and qualification stream"
  capacity 1

milestone SOFTWARE_QUALIFIED:
  title "Expanded v7 software qualification complete"
  description |
    Dense direct, single-, double-, and triple-indirect regular-file mutation,
    recovery, detect-only fsck, and non-destructive qualification are complete.
  state reached

milestone MEDIA_AUTHORIZED:
  title "Exact media apparatus and destructive run authorized"

milestone VHDX_HARNESS_READY:
  title "Resumable Windows-host VHDX recovery harness ready"
  state reached

milestone VHDX_HOST_RECOVERY_QUALIFIED:
  title "Windows-host VHDX terminate/restart recovery qualified"

milestone REAL_MEDIA_EXECUTION_READY:
  title "Virtual prequalification and physical-media authorization complete"

milestone MEDIA_QUALIFIED:
  title "Real-media recovery and wear qualification complete"

milestone PRODUCTION_CUTOVER_DECIDED:
  title "Migration and production cutover evidence accepted"

task HARDWARE_APPROVAL SOFTWARE_QUALIFIED -> MEDIA_AUTHORIZED:
  title "Bind exact card, reader, power-cut apparatus, cycle count, and approval"
  description |
    The low-confidence estimate covers repository and operator work after the
    external inputs become available. It intentionally excludes unknown
    external calendar wait and does not affect ordering in this serial residual
    network.
  estimate:
    optimistic 1d
    most_likely 1d
    pessimistic 2d
  status blocked
  blocked_reason |
    Exact card, reader/controller, isolated power-cut apparatus, cycle count,
    and digest-bound destructive approval are unavailable and deferred.
  owner "external approver and KAFS operator"
  source "docs/sd-card-wear-v7-real-media-qualification-approval.md"
  requires:
    PRIMARY_STREAM 1

task VHDX_HOST_RECOVERY_RUN VHDX_HARNESS_READY -> VHDX_HOST_RECOVERY_QUALIFIED:
  title "Run and verify VHDX-backed recovery across WSL terminate/restart"
  description |
    Run the resumable harness from Windows Host against only its disposable KAFS
    image. Terminate and restart the Ubuntu distro at the defined boundaries,
    then preserve fsck, dump, payload, host, distro, and VHDX identity evidence.
    Make no physical-media, wear, controller, or isolated-power claim.
  estimate:
    optimistic 1d
    most_likely 1d
    pessimistic 2d
  owner "Windows host operator and KAFS implementation stream"
  source "docs/sd-card-wear-v7-indirect-pert-20260721.md"
  requires:
    PRIMARY_STREAM 1

gate VHDX_RECOVERY_REQUIRED VHDX_HOST_RECOVERY_QUALIFIED -> REAL_MEDIA_EXECUTION_READY:
  reason "Host-level virtual-media recovery evidence is required before physical execution"

gate HARDWARE_APPROVAL_REQUIRED MEDIA_AUTHORIZED -> REAL_MEDIA_EXECUTION_READY:
  reason "Physical execution still requires disposable media and isolated-power approval"

task REAL_MEDIA_QUALIFICATION REAL_MEDIA_EXECUTION_READY -> MEDIA_QUALIFIED:
  title "Run approved real-media recovery and wear qualification"
  estimate:
    optimistic 3d
    most_likely 5d
    pessimistic 9d
  owner "KAFS operator"
  source "docs/sd-card-wear-v7-controlled-write-qualification.md"
  requires:
    PRIMARY_STREAM 1

task MIGRATION_CUTOVER_EVIDENCE MEDIA_QUALIFIED -> PRODUCTION_CUTOVER_DECIDED:
  title "Produce migration and production cutover evidence"
  estimate:
    optimistic 5d
    most_likely 10d
    pessimistic 18d
  owner "KAFS implementation stream"
  source "docs/sd-card-wear-v7-indirect-pert-20260721.md"
  requires:
    PRIMARY_STREAM 1
